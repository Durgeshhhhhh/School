# 1. School Identity Metadata
APP_NAME="Little Orbit Preschool"
APP_SHORT_NAME="Little Orbit"
APP_DESCRIPTION="A loving, joyful pre-primary school providing early childhood education, playgroup, nursery, and kindergarten for ages 1.5 to 6 years."
APP_TAGLINE="Where Little Stars Begin Their Journey"
APP_ACADEMIC_YEAR="2026-2027"
APP_ADMISSIONS_STATUS="OPEN"
APP_THEME_COLOR="#FB8500"
APP_URL="https://littleorbitpreschool.com"

# 2. Contact & Campus Information
SCHOOL_PHONE="+91 93560 62067"
SCHOOL_PHONE_RAW="919356062067"
SCHOOL_WHATSAPP="+91 98509 71075"
SCHOOL_WHATSAPP_RAW="919850971075"
SCHOOL_WHATSAPP_DEFAULT_MSG="Hello Little Orbit Preschool! I would like to inquire about admissions for the 2026-2027 academic year."
