SCHOOL_ADDRESS="Plot No. 42, Sunshine Garden Road, Near Central Park, Pune, Maharashtra 411001"
SCHOOL_OPERATING_HOURS="Classes: Mon - Fri: 9:30 AM - 12:30 PM | Office: Mon - Sat: 9:00 AM - 2:00 PM"
SCHOOL_AGE_CRITERIA="1.5 Years to 6 Years"

